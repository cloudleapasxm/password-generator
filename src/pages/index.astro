---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/layout/Header';
import Footer from '../components/layout/Footer.astro';
import { PasswordGenerator } from '../components/generator/PasswordGenerator';
---

<BaseLayout
  title="SecurePass — Secure Password Generator"
  description="Generate strong, random passwords, PINs, and memorable passphrases locally in your browser. No servers, no tracking, no storage."
  canonicalPath="/"
>
  <Header client:load />
  <main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6">
    <div class="app-fade-in">
      <div class="mb-8 max-w-2xl">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
          Generate a secure password
        </h1>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600 sm:text-base dark:text-zinc-400">
          Pick a length, choose your characters, and copy a fresh password in one click.
          Everything is created on your device with your browser’s cryptographic random
          number generator — nothing ever leaves this page.
        </p>
      </div>
      <PasswordGenerator client:load />
    </div>
  </main>
  <Footer />
</BaseLayout>
