---
import { link } from '../../lib/site';
/** Minimal static footer — no client JS needed. */
---

<footer class="border-t border-line">
  <div class="sp-container flex flex-col gap-3 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      <span class="font-semibold text-ink">SecurePass</span>
      {' '}— passwords are generated locally in your browser.
    </p>
    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <a href={link('about')} class="rounded transition-colors duration-150 can-hover:hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">About</a>
      <a href={link('privacy')} class="rounded transition-colors duration-150 can-hover:hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Privacy</a>
      <a href="https://github.com/cloudleapasxm/password-generator" class="rounded transition-colors duration-150 can-hover:hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">GitHub</a>
    </nav>
  </div>
</footer>
